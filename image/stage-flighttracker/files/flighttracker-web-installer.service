[Unit]
Description=FlightTracker Web Installer
Documentation=https://github.com/ColinWaddell/FlightTracker
After=network-online.target avahi-daemon.service
Wants=network-online.target
# Disable after a successful install (the app writes this sentinel file)
ConditionPathExists=!/opt/flighttracker-installer/.installed

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/flighttracker-installer/app.py
WorkingDirectory=/root
Restart=on-failure
RestartSec=5

# Run as root so the installer can call apt-get, pip, systemctl etc.
User=root

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ft-installer

[Install]
WantedBy=multi-user.target
